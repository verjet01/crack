{
  "version": 2,
  "public": true,
  "installCommand": "cd backend && npm install --production",
  "buildCommand": "",
  "outputDirectory": "frontend",
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/src/index.js" },
    { "src": "/activate", "dest": "backend/src/index.js" },
    { "src": "/ja-netfilter/(.*)", "dest": "backend/src/index.js" },
    { "src": "/(.*\\.(css|js|html|png|jpg|ico|svg))", "dest": "/frontend/$1" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
